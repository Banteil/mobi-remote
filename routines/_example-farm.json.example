{
  "_주의": "이 파일은 템플릿입니다. 확장자에서 .example 을 떼면 루틴 목록에 나타납니다. execute_gathering / execute_crafting / execute_altering 은 각각 1회당 정령의 날개 5를 씁니다 (complete_altering_work 는 무료). 아이템 이름은 mm-auto gather --list --ok / craft --list --ok / alter --ok 로 확인한 표기와 정확히 같아야 합니다.",

  "name": "양털 파밍 + 옷감 가공",
  "description": "양털 200개 채집 → 옷감 가공 2건 큐 등록 → 완료분 수령",

  "steps": [
    {
      "label": "현재 상태 확인",
      "command": "get_my_info"
    },
    {
      "label": "양털 채집",
      "command": "execute_gathering",
      "body": { "displayName": "양털" },
      "repeat": 2,
      "guard": { "maxWeightPct": 90 },
      "stopOnError": true,
      "delayAfter": 1000,
      "_설명": "1회 호출당 최대 100개까지 모으고 멈추므로 200개는 repeat 2. guard는 가방 무게가 90%를 넘으면 건너뛴다."
    },
    {
      "label": "잠시 대기",
      "wait": 2000
    },
    {
      "label": "옷감 가공 큐 등록",
      "command": "execute_altering",
      "body": { "displayName": "옷감" },
      "repeat": 2,
      "stopOnError": false,
      "delayAfter": 1000,
      "_설명": "가공은 비동기 큐다. 호출은 등록만 하고 끝나며, 완성까지 시간이 걸린다. 1건씩 등록되므로 N건은 repeat N."
    },
    {
      "label": "가공 진행 확인",
      "command": "get_altering_works"
    },
    {
      "label": "완료된 가공 수령",
      "command": "complete_altering_work",
      "body": { "displayName": "옷감" },
      "stopOnError": false,
      "_설명": "해당 아이템을 만드는 시설의 완료분을 전부 수령한다. 아직 진행 중이면 not_completed_yet 으로 거부되므로 stopOnError:false 로 둔다."
    }
  ],

  "_제작을_넣고_싶다면": {
    "label": "예: 못 제작",
    "command": "execute_crafting",
    "body": { "displayName": "못", "craftCount": 5 },
    "guard": { "maxWeightPct": 95 },
    "_설명": "craftCount는 제작 횟수이지 결과 개수가 아니다 (못은 1회당 10개 산출). 시설별 상한을 넘으면 invalid_count로 거부되고 maxCount가 함께 온다."
  }
}
